#!/bin/sh
# session-start-hook — put the state in front of the agent before it guesses.
#
# On 2026-09-01 and twice on 2026-09-03, agents opened a Candor session, read a
# stale file instead of the running system, and handed the CEO confident wrong
# diagnoses. The brain held the right answer every time. Nothing put it in
# front of them, and nothing made them look.
#
# gbrain's push channel needs a single-process PGLite engine; Candor's brain is
# shared Postgres so Claude and Codex see one truth. That trade is correct and
# it costs the push lane. This hook is the third way: pull, once, at the start.
#
# Contract: never block, never fail the session, never spend on a model. Every
# probe is bounded and every failure is silent. Worst case it prints nothing.

set -u

# Not a Candor worktree: say nothing at all.
[ -f docs/decisions/_active.md ] || exit 0

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0

printf '## Candor session state (auto-loaded, not typed by the user)\n\n'
printf 'Branch: %s\n\n' "$BRANCH"

# The governing block. _active.md opens with a box that says it is the only
# thing that binds; everything under it is context that ages. Print the newest
# CEO goal section inside that box, not the box's own header — the header is a
# rule about the file, the section is the goal.
printf '### What governs right now\n\n'
GOAL_LINE=$(grep -n '^### CEO goal' docs/decisions/_active.md 2>/dev/null | tail -1 | cut -d: -f1)
if [ -n "$GOAL_LINE" ]; then
  sed -n "${GOAL_LINE},\$p" docs/decisions/_active.md 2>/dev/null | head -26 | sed 's/^/> /'
else
  sed -n '/READ THIS FIRST/,$p' docs/decisions/_active.md 2>/dev/null | head -26 | sed 's/^/> /'
fi
printf '\n'

# Work that exists only on this disk. The reason the CEO lost a night worrying.
UNPUSHED=""
if git rev-parse --verify "origin/$BRANCH" >/dev/null 2>&1; then
  N=$(git rev-list --count "origin/$BRANCH..$BRANCH" 2>/dev/null || echo 0)
  [ "$N" != "0" ] && UNPUSHED="$N commit(s) not on GitHub"
else
  N=$(git rev-list --count "origin/main..$BRANCH" 2>/dev/null || echo 0)
  [ "$N" != "0" ] && UNPUSHED="$N commit(s) on a branch that was never pushed"
fi
DIRTY=$(git status --porcelain 2>/dev/null | grep -vE '^\?\? (tmp/|node_modules/)' | wc -l | tr -d ' ')
[ -n "$DIRTY" ] || DIRTY=0

if [ -n "$UNPUSHED" ] || [ "$DIRTY" != "0" ]; then
  printf '### At risk on this disk\n\n'
  [ -n "$UNPUSHED" ] && printf -- '- %s\n' "$UNPUSHED"
  [ "$DIRTY" != "0" ] && printf -- '- %s uncommitted file(s)\n' "$DIRTY"
  printf '\n'
fi

# The map exists so nobody reconstructs the architecture from fragments again.
[ -f docs/operations/candor-factory-map.md ] && \
  printf '### Read before diagnosing\n\n- docs/operations/candor-factory-map.md — thirteen stations, one page\n- AGENTS.md — the operating contract\n\n'

# The brain answers these in seconds; grep and long file reads do not.
printf '### Ask the running system, not a document\n\n'
printf -- '- `mcp__gbrain__recall` — decisions, goals, prior attempts (the brain holds ~4k pages across 6 sources; a bare recall shows only one, so pass a query)\n'
printf -- '- `mcp__gbrain__code_blast <symbol>` — everything a change breaks, before editing\n'
printf -- '- `mcp__gbrain__code_def <symbol>` — where it lives, without reading the file\n'
printf -- '- GitHub and the worktree are the state. A PR body, a decision file or a status page describes a past moment.\n\n'

exit 0
