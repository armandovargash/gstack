#!/bin/sh
# skill-router-hook — match the user's own words against every skill's declared
# triggers, and say which skill owns the request. Runs on UserPromptSubmit.
#
# The routing contract already exists: _AGENT_README.md says "on every user
# message, match the message against every skill's triggers: array". It was
# written for the agent to follow by hand, and an agent that forgets to look
# routes on vibes instead. Vercel's plugin solves the same problem the same
# way: score the prompt, inject the skills that match.
#
# This does the matching mechanically, so picking the right skill stops
# depending on whether the agent remembered that skills exist. It never picks
# for the agent: it surfaces candidates and the agent still decides.
#
# Contract: never block, never fail the turn, never spend on a model, never
# echo the user's text back. Silent when nothing matches.

set -u

GSTACK_SKILLS="${GSTACK_HOME:-$HOME/.gstack}/repos/gstack"
CANDOR_SKILLS="$HOME/.candor/candor-agent-workspace/skills"
CACHE="${GSTACK_HOME:-$HOME/.gstack}/.skill-trigger-index"

# The prompt arrives as JSON on stdin. Pull the field without a JSON parser
# dependency; a prompt we cannot read means we stay silent.
PROMPT=$(cat 2>/dev/null | sed -n 's/.*"prompt"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/p' | head -c 2000)
[ -n "$PROMPT" ] || exit 0

# Build the trigger index once, refresh it when a SKILL.md is newer than it.
# Format per line: <skill-slug>\t<trigger phrase>
build_index() {
  for f in "$GSTACK_SKILLS"/*/SKILL.md "$CANDOR_SKILLS"/*/SKILL.md; do
    [ -f "$f" ] || continue
    slug=$(basename "$(dirname "$f")")
    awk -v s="$slug" '
      /^triggers:/ { inblock=1; next }
      /^[a-zA-Z_-]+:/ { inblock=0 }
      inblock && /^ *- / {
        line=$0
        sub(/^ *- */, "", line)
        gsub(/"/, "", line)
        gsub(/\r/, "", line)
        if (length(line) > 2) print s "\t" tolower(line)
      }
    ' "$f" 2>/dev/null
  done
}

newest=$(find "$GSTACK_SKILLS" "$CANDOR_SKILLS" -name SKILL.md -newer "$CACHE" 2>/dev/null | head -1)
if [ ! -s "$CACHE" ] || [ -n "$newest" ]; then
  build_index > "$CACHE.tmp" 2>/dev/null && mv "$CACHE.tmp" "$CACHE" 2>/dev/null
fi
[ -s "$CACHE" ] || exit 0

LOWER=$(printf '%s' "$PROMPT" | tr '[:upper:]' '[:lower:]')

# Every declared trigger is written in English; Armando writes in Spanish, so a
# literal match misses his actual words. Widen the haystack with the English
# equivalents of how he really asks — never narrow it, never replace his text.
# One line per skill, appended so both languages can match.
case "$LOWER" in
  *bug*|*error*|*fall[oa]*|*rot[oa]*|*"no funciona"*|*"se rompe"*|*"por que"*|*"por qué"*|*caus[ao]*)
    LOWER="$LOWER debug this fix this bug root cause analysis investigate this error" ;;
esac
case "$LOWER" in
  *seguridad*|*vulnerab*|*"fuga de datos"*) LOWER="$LOWER security audit check for vulnerabilities" ;;
esac
case "$LOWER" in
  *"probar el sitio"*|*"prueba el sitio"*|*navegador*|*"en el browser"*) LOWER="$LOWER qa test this test the site" ;;
esac
case "$LOWER" in
  *"revisa el codigo"*|*"revisa el código"*|*"revisa la pr"*|*"revisa el pr"*|*diff*) LOWER="$LOWER code review review this pr" ;;
esac
case "$LOWER" in
  *"sube el pr"*|*"abre un pr"*|*"crea el pr"*|*despliega*|*"a produccion"*|*"a producción"*)
    LOWER="$LOWER ship it create a pr deploy this merge and deploy" ;;
esac
case "$LOWER" in
  *"vale la pena"*|*"tiene sentido construir"*|*"deberiamos construir"*|*"deberíamos construir"*|*idea*)
    LOWER="$LOWER is this worth building brainstorm this help me think through" ;;
esac
case "$LOWER" in
  *"salud del codigo"*|*"salud del código"*|*"deuda tecnica"*|*"deuda técnica"*|*"calidad del codigo"*)
    LOWER="$LOWER code health check quality dashboard" ;;
esac
case "$LOWER" in
  *"se ve mal"*|*"se ve feo"*|*diseño*|*"revision visual"*|*"revisión visual"*)
    LOWER="$LOWER visual design audit design qa" ;;
esac
case "$LOWER" in
  *"donde estaba"*|*"dónde estaba"*|*"retoma"*|*"continua donde"*|*"continúa donde"*|*"ponte al dia"*|*"ponte al día"*)
    LOWER="$LOWER resume where i left off restore context where was i" ;;
esac
case "$LOWER" in
  *"guarda el contexto"*|*"guarda el progreso"*|*"guarda mi trabajo"*) LOWER="$LOWER save progress save my work context save" ;;
esac

# A trigger matches when its phrase appears in the prompt. Longer phrases are
# stronger evidence, so rank by length and keep the top few.
MATCHES=$(awk -F'\t' -v p="$LOWER" '
  {
    if (index(p, $2) > 0) print length($2) "\t" $1 "\t" $2
  }
' "$CACHE" 2>/dev/null | sort -rn | awk -F'\t' '!seen[$2]++' | head -3)

[ -n "$MATCHES" ] || exit 0

printf '## Skill routing (matched mechanically against declared triggers)\n\n'
printf '%s\n' "$MATCHES" | while IFS="$(printf '\t')" read -r _len slug phrase; do
  printf -- '- **/gstack-%s** — the phrase "%s" is a declared trigger for it.\n' "$slug" "$phrase"
done
printf '\nRead the matching SKILL.md in full and follow its workflow, or say in one line why it does not fit this request. These are candidates, not orders.\n\n'

exit 0
